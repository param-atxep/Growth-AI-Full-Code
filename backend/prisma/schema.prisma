// GrowthPilot AI - Prisma Schema
// Multi-tenant architecture with complete data isolation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  avatar            String?
  isEmailVerified   Boolean   @default(false)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  stores            Store[]
  refreshTokens     RefreshToken[]
  notifications     Notification[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================
// STORE (TENANT)
// ============================================

model Store {
  id                    String    @id @default(uuid())
  userId                String
  name                  String
  businessType          String?
  gstin                 String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  phone                 String?
  email                 String?
  logo                  String?
  currency              String    @default("INR")
  timezone              String    @default("Asia/Kolkata")
  fiscalYearStart       Int       @default(4) // April
  lowStockThreshold     Int       @default(10)
  enableNotifications   Boolean   @default(true)
  enableWeeklyReport    Boolean   @default(true)
  darkMode              Boolean   @default(false)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Credit System
  creditBalance         Int       @default(100)
  
  // Relations
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products              Product[]
  categories            Category[]
  sales                 Sale[]
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  creditTransactions    CreditTransaction[]
  aiUsageLogs           AIUsageLog[]
  customers             Customer[]
  suppliers             Supplier[]
  alerts                Alert[]
  payments              Payment[]

  @@index([userId])
  @@index([name])
  @@map("stores")
}

// ============================================
// PRODUCT & INVENTORY
// ============================================

model Category {
  id          String    @id @default(uuid())
  storeId     String
  name        String
  description String?
  color       String?
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id                  String    @id @default(uuid())
  storeId             String
  categoryId          String?
  sku                 String
  barcode             String?
  name                String
  description         String?
  costPrice           Decimal   @db.Decimal(12, 2)
  sellingPrice        Decimal   @db.Decimal(12, 2)
  mrp                 Decimal?  @db.Decimal(12, 2)
  gstRate             Decimal   @default(0) @db.Decimal(5, 2)
  hsnCode             String?
  unit                String    @default("pcs")
  stockQuantity       Int       @default(0)
  lowStockThreshold   Int       @default(10)
  reorderQuantity     Int       @default(50)
  location            String?   // Shelf/Rack location
  expiryDate          DateTime?
  batchNumber         String?
  imageUrl            String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Analytics fields
  totalSold           Int       @default(0)
  lastSoldAt          DateTime?
  lastRestockedAt     DateTime?

  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category            Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems           SaleItem[]
  stockMovements      StockMovement[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
  @@index([barcode])
  @@index([name])
  @@map("products")
}

model StockMovement {
  id              String    @id @default(uuid())
  productId       String
  type            StockMovementType
  quantity        Int
  previousStock   Int
  newStock        Int
  reason          String?
  reference       String?   // Purchase order, sale ID, etc.
  createdAt       DateTime  @default(now())

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  EXPIRED
}

// ============================================
// SALES & INVOICING
// ============================================

model Customer {
  id          String    @id @default(uuid())
  storeId     String
  name        String
  email       String?
  phone       String?
  address     String?
  gstin       String?
  totalPurchases Decimal @default(0) @db.Decimal(14, 2)
  totalVisits Int       @default(0)
  lastVisitAt DateTime?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales       Sale[]

  @@index([storeId])
  @@index([phone])
  @@map("customers")
}

model Sale {
  id              String      @id @default(uuid())
  storeId         String
  customerId      String?
  invoiceNumber   String
  invoiceDate     DateTime    @default(now())
  
  // Amounts
  subtotal        Decimal     @db.Decimal(14, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  discountPercent Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(14, 2)
  
  // Cost & Profit
  totalCost       Decimal     @db.Decimal(14, 2)
  profit          Decimal     @db.Decimal(14, 2)
  profitMargin    Decimal     @db.Decimal(5, 2)
  
  // Payment
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PAID)
  paidAmount      Decimal     @db.Decimal(14, 2)
  dueAmount       Decimal     @default(0) @db.Decimal(12, 2)
  
  notes           String?
  status          SaleStatus  @default(COMPLETED)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           SaleItem[]

  @@unique([storeId, invoiceNumber])
  @@index([storeId])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id              String    @id @default(uuid())
  saleId          String
  productId       String
  productName     String    // Snapshot of product name
  sku             String    // Snapshot of SKU
  quantity        Int
  unitPrice       Decimal   @db.Decimal(12, 2)
  costPrice       Decimal   @db.Decimal(12, 2)
  discount        Decimal   @default(0) @db.Decimal(12, 2)
  gstRate         Decimal   @default(0) @db.Decimal(5, 2)
  gstAmount       Decimal   @default(0) @db.Decimal(12, 2)
  totalPrice      Decimal   @db.Decimal(12, 2)
  profit          Decimal   @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())

  sale            Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CREDIT
  MIXED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
  REFUNDED
}

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
  RETURNED
}

// ============================================
// EXPENSES
// ============================================

model ExpenseCategory {
  id          String    @id @default(uuid())
  storeId     String
  name        String
  description String?
  color       String?
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("expense_categories")
}

model Expense {
  id              String    @id @default(uuid())
  storeId         String
  categoryId      String?
  title           String
  description     String?
  amount          Decimal   @db.Decimal(12, 2)
  date            DateTime  @default(now())
  paymentMethod   PaymentMethod @default(CASH)
  reference       String?
  receipt         String?   // URL to receipt image
  isRecurring     Boolean   @default(false)
  recurringPeriod String?   // daily, weekly, monthly
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category        ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([categoryId])
  @@index([date])
  @@map("expenses")
}

// ============================================
// SUPPLIERS
// ============================================

model Supplier {
  id          String    @id @default(uuid())
  storeId     String
  name        String
  email       String?
  phone       String?
  address     String?
  gstin       String?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("suppliers")
}

// ============================================
// CREDIT SYSTEM
// ============================================

model CreditTransaction {
  id              String    @id @default(uuid())
  storeId         String
  type            CreditTransactionType
  amount          Int       // Positive for credit, negative for debit
  balanceAfter    Int
  description     String
  reference       String?   // Payment reference, usage ID, etc.
  paymentId       String?   // External payment provider ID
  metadata        Json?
  createdAt       DateTime  @default(now())

  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([createdAt])
  @@index([type])
  @@map("credit_transactions")
}

enum CreditTransactionType {
  INITIAL_GRANT
  PURCHASE
  AI_USAGE
  REFUND
  BONUS
  EXPIRED
}

model AIUsageLog {
  id              String    @id @default(uuid())
  storeId         String
  feature         AIFeature
  creditsUsed     Int
  prompt          String?   @db.Text
  response        String?   @db.Text
  tokensUsed      Int?
  latencyMs       Int?
  success         Boolean   @default(true)
  errorMessage    String?
  createdAt       DateTime  @default(now())

  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([feature])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

enum AIFeature {
  SALES_PREDICTION
  CHAT_ASSISTANT
  RESTOCK_RECOMMENDATION
  MARKETING_SUGGESTION
  PRODUCT_ANALYSIS
  GROWTH_INSIGHTS
}

// ============================================
// NOTIFICATIONS & ALERTS
// ============================================

model Notification {
  id          String    @id @default(uuid())
  userId      String
  title       String
  message     String
  type        NotificationType
  isRead      Boolean   @default(false)
  link        String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  LOW_STOCK
  PROFIT_DROP
  CREDIT_LOW
  WEEKLY_REPORT
  SYSTEM
  PROMOTION
}

model Alert {
  id          String    @id @default(uuid())
  storeId     String
  type        AlertType
  title       String
  message     String
  severity    AlertSeverity @default(MEDIUM)
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([isResolved])
  @@index([type])
  @@map("alerts")
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRING_SOON
  PROFIT_DROP
  DEAD_STOCK
  CREDIT_LOW
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================
// PAYMENT GATEWAY
// ============================================

model Payment {
  id                    String        @id @default(uuid())
  storeId               String
  stripeSessionId       String        @unique
  stripePaymentIntentId String?
  amount                Int           // Amount in cents (smallest currency unit)
  currency              String        @default("USD")
  status                PaymentStatus2
  planId                String
  credits               Int           // Credits to add after payment
  failureReason         String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  store                 Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([stripeSessionId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

enum PaymentStatus2 {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  EXPIRED
}

# GrowthPilot AI - Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=growthpilot
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=growthpilot
DB_PORT=5432

# Connection string for backend
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}?schema=public

# ===========================================
# JWT Authentication
# ===========================================
# Generate secure secrets: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Token expiration
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# OpenAI Configuration
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model configuration
OPENAI_MODEL=gpt-4-turbo-preview

# ===========================================
# Redis Configuration (Optional)
# ===========================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ===========================================
# Application Ports
# ===========================================
BACKEND_PORT=3000
FRONTEND_PORT=80

# Frontend API URL (for development)
VITE_API_URL=http://localhost:3000/api

# ===========================================
# Credit System
# ===========================================
# Credits given to new users on signup
INITIAL_CREDITS=100

# Credits consumed per AI operation
CREDITS_PER_OPERATION=4

# ===========================================
# Email Configuration (Optional)
# ===========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@growthpilot.ai

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# ===========================================
# Security
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info
LOG_FORMAT=combined

# ===========================================
# Node Environment
# ===========================================
NODE_ENV=development
